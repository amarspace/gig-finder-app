# =============================================================================
# GIGFINDER - Event Aggregation System Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration (Required for Ukrainian Platform Scrapers)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# API Keys for Event Providers
# -----------------------------------------------------------------------------

# Bandsintown API
# Get your API key at: https://www.bandsintown.com/api/overview
# Note: Bandsintown allows using app_id instead of API key
# You can use any string (e.g., "gigfinder_app")
VITE_BANDSINTOWN_API_KEY=gigfinder_app

# Songkick API
# Get your API key at: https://www.songkick.com/developer
# Sign up and request API access
VITE_SONGKICK_API_KEY=your-songkick-api-key-here

# -----------------------------------------------------------------------------
# Cache Configuration (Optional)
# -----------------------------------------------------------------------------

# Cache TTL in milliseconds (default: 900000 = 15 minutes)
VITE_EVENT_CACHE_TTL=900000

# Enable/disable caching (default: true)
VITE_EVENT_CACHE_ENABLED=true

# -----------------------------------------------------------------------------
# Provider Configuration (Optional)
# -----------------------------------------------------------------------------

# Timeout for API requests in milliseconds (default: 10000 = 10 seconds)
VITE_EVENT_PROVIDER_TIMEOUT=10000

# Maximum retries for failed requests (default: 3)
VITE_EVENT_PROVIDER_MAX_RETRIES=3

# Timeout for web scraping operations (default: 30000 = 30 seconds)
VITE_SCRAPER_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------

# Enable/disable specific providers
VITE_ENABLE_BANDSINTOWN=true
VITE_ENABLE_SONGKICK=true
VITE_ENABLE_CONCERT_UA=true
VITE_ENABLE_KONTRAMARKA=true
VITE_ENABLE_KARABAS=true
VITE_ENABLE_OTTRY=true

# -----------------------------------------------------------------------------
# Development/Debug Settings
# -----------------------------------------------------------------------------

# Enable verbose logging
VITE_DEBUG_EVENTS=false

# Fail fast mode (stop on first provider error)
VITE_FAIL_FAST=false
